# Segreti: nessun file .env deve entrare nell'immagine, in nessuna cartella.
**/.env*

# Dipendenze e ambienti locali: nell'immagine si reinstallano da zero.
**/node_modules
**/venv
**/__pycache__
**/.ipynb_checkpoints

# Build e dati generati: si rigenerano durante la build o all'avvio.
front end/dist
back end/chroma_data
data_agent/charts/*.png

# Non servono all'esecuzione.
.git
**/.DS_Store
.vscode
docs
data_agent/prototype.ipynb

# Test e strumenti di sviluppo del data agent: non servono in produzione
# (l'immagine installa solo requirements.txt).
data_agent/tests
data_agent/pytest.ini
data_agent/requirements-dev.txt
**/.pytest_cache

# Test e strumenti di sviluppo di back end e front end: non servono in produzione.
# La fase di build del front end installa comunque vitest e jsdom, ma
# nell'immagine finale arriva solo dist/.
back end/test
back end/eval
front end/test
front end/vitest.config.js
