# URL base del back end (il browser parla solo con lui, mai con il data agent o con Chroma).
# Copia questo file in ".env" e adatta il valore se il back end gira su un'altra porta.
# Vite espone al browser solo le variabili che iniziano con VITE_: qui non vanno mai chiavi segrete.
VITE_API_URL=http://localhost:3001
