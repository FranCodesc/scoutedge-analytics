# Copia questo file in ".env" (stessa cartella) e compila i valori.
# Il file ".env" contiene segreti e non va mai committato.

# Chiave API OpenAI (obbligatoria): serve per gli embedding della RAG e per
# l'LLM dell'orchestratore. Lasciarla vuota in questo file.
OPENAI_API_KEY=

# Porta del back end
PORT=3001

# ATTENZIONE: gli URL qui sotto richiedono sempre il protocollo (http:// o
# https://). Senza, il back end rifiuta il valore con un errore esplicito.

# Data agent (FastAPI, Python)
DATA_AGENT_URL=http://127.0.0.1:8000

# Server Chroma (Docker, porta 8001)
CHROMA_URL=http://localhost:8001

# Origine del front end ammessa dalla CORS (server di sviluppo Vite)
FRONTEND_ORIGIN=http://localhost:5173

# --- Limite di frequenza su POST /api/chat (facoltativo) ---
# Lasciate commentate, il limite è DISATTIVATO (uso in locale e test).
# Per attivarlo servono TUTTE E TRE le prime variabili: se ne manca una, o il
# valore non è un intero positivo, il back end non parte. Valori della demo online:
# RATE_LIMIT_WINDOW_MIN=15   # finestra di tempo, in minuti (massimo 1440)
# RATE_LIMIT_PER_IP=20       # richieste per client (IP) nella finestra
# RATE_LIMIT_GLOBAL=100      # richieste totali nella finestra, da tutti i client

# Numero di proxy (es. nginx) davanti al back end; intero >= 0. Se assente il
# back end non si fida di X-Forwarded-For e usa l'IP della connessione.
# Serve solo dietro un proxy, altrimenti tutti i client risulterebbero lo
# stesso IP; il valore giusto dipende dalla catena di proxy.
# TRUST_PROXY=1
