# Copia questo file in ".env" (stessa cartella) e compila il valore.
# Il file ".env" contiene segreti e non va mai committato.

# Chiave API OpenAI (obbligatoria): serve al modello che genera ed esegue
# il codice di analisi sui dati. Può essere la stessa del back end.
# Lasciarla vuota in questo file.
OPENAI_API_KEY=

# Cartella dei rapporti di qualità dei dati (facoltativa). Se non è impostata:
# data_agent/quality_reports/. Un percorso relativo si intende rispetto a data_agent/,
# non alla cartella da cui si lancia uvicorn.
# QUALITY_REPORTS_DIR=
